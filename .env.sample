# =============================================================================
# SecureNet AI — Hybrid Cloud-Local SOC Architecture Sample Environment (.env)
# =============================================================================
# Architecture Overview:
# 1. Frontend (Vercel): React/Vite web application
# 2. Database & Auth (Supabase): PostgreSQL DB + GoTrue JWT Authentication
# 3. NIDS Sensor & Firewall (Local PC): Python/FastAPI exposed via Ngrok tunnel
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel & frontend/.env)
# -----------------------------------------------------------------------------

# Supabase Project Credentials (Found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-anon-key

# Ngrok Sensor Tunnel URL (HTTPS URL generated by running: ngrok http 8000)
# Automatically converted to wss:// for WebSocket telemetry by frontend/src/utils/api.js
VITE_SENSOR_API_URL=https://your-tunnel-subdomain.ngrok-free.app

# Optional WebSocket URL Override (Leave blank to use auto-converted wss:// URL from VITE_SENSOR_API_URL)
# VITE_WS_URL=wss://your-tunnel-subdomain.ngrok-free.app/ws/stream


# -----------------------------------------------------------------------------
# 2. BACKEND / LOCAL SENSOR VARIABLES (Configure in backend/.env on Local PC)
# -----------------------------------------------------------------------------

# Supabase JWT Secret (Found in Supabase Project Settings -> API -> JWT Settings -> JWT Secret)
# Used by FastAPI get_current_user to cryptographically verify operator Bearer tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase PostgreSQL Database Connection String
# Found in Supabase Project Settings -> Database -> Connection String (URI / Session Pooler)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:YourPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Local SQLite Fallback (Use this if testing backend without Supabase PostgreSQL connection):
# DATABASE_URL=sqlite:///./securenet.db

# Network Interface Selection (Scapy NIC auto-binding)
# Can be interface index (e.g., 1) or specific adapter IP / interface name.
# Leave blank to auto-detect the default active LAN/Wi-Fi interface statelessly.
SECURENET_IFACE=1

# Ingress Capture Filter Mode: soc_filtered | targeted | raw_all
CAPTURE_FILTER_MODE=soc_filtered

# Automated Defense & Active Firewall Safety Boundaries
# Set to 'true' to simulate firewall actions safely without kernel netsh/iptables drops
SIMULATION_MODE=true
REAL_FIREWALL_ENFORCEMENT_AUTHORIZED=false

# Protected Network Infrastructure Allowlists (Comma-separated IPs immune to firewall drops)
ALLOWLIST_IPS=127.0.0.1,10.0.0.1,192.168.1.1,8.8.8.8,1.1.1.1,10.0.0.50

# External NIDS Sensor Telemetry (Optional Suricata EVE log integration)
SURICATA_EVE_PATH=/var/log/suricata/eve.json
