 # SecureNet AI — Backend Configuration (.env.example)
# Copy to .env and customize for your environment. Never commit production secrets.

# Database Configuration
# Default is SQLite file (./securenet.db). For production PostgreSQL, set:
# DATABASE_URL=postgresql://securenet_user:password@localhost:5432/securenet_db
DATABASE_URL=sqlite:///./securenet.db

# JWT & Authentication
SECRET_KEY=SECURENET_SUPER_SECRET_ENTERPRISE_KEY_JWT_2026_NIDS_NIPS
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Network Sniffer Adapter Selection
# Interface index (e.g. 1) or IP address to bind raw socket capture
SECURENET_IFACE=1

# Ingress Capture Filter Mode: soc_filtered | targeted | raw_all
CAPTURE_FILTER_MODE=soc_filtered

# Automated Defense & Firewall Safety Boundaries
# Default is simulation mode (true). Real enforcement requires explicit authorization.
SIMULATION_MODE=true
REAL_FIREWALL_ENFORCEMENT_AUTHORIZED=false

# Protected Network Infrastructure Allowlists (comma-separated IPs)
# Addresses immune to automated isolation (e.g. gateways, DNS, localhost)
ALLOWLIST_IPS=127.0.0.1,10.0.0.1,192.168.1.1,8.8.8.8,1.1.1.1,10.0.0.50

# External NIDS Sensor (e.g. Suricata EVE log integration)
SURICATA_EVE_PATH=/var/log/suricata/eve.json
