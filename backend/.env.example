# SecureNet AI — Backend Configuration (.env.example)
# Copy to .env on the local PC running the sensor. Never commit production secrets.

# Supabase Auth Integration
# JWT Secret from Supabase Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Database Configuration (Supabase PostgreSQL or local SQLite)
# For Supabase PostgreSQL, use connection pooler (port 6543) or direct connection (port 5432):
# DATABASE_URL=postgresql://postgres.yourprojectref:YourPassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./securenet.db

# Legacy / Local JWT Fallback
SECRET_KEY=SECURENET_SUPER_SECRET_ENTERPRISE_KEY_JWT_2026_NIDS_NIPS
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Network Sniffer Adapter Selection (Auto-selects active NIC if left blank)
SECURENET_IFACE=1

# Ingress Capture Filter Mode: soc_filtered | targeted | raw_all
CAPTURE_FILTER_MODE=soc_filtered

# Automated Defense & Firewall Safety Boundaries
SIMULATION_MODE=true
REAL_FIREWALL_ENFORCEMENT_AUTHORIZED=false

# Protected Network Infrastructure Allowlists (comma-separated IPs)
ALLOWLIST_IPS=127.0.0.1,10.0.0.1,192.168.1.1,8.8.8.8,1.1.1.1,10.0.0.50

# External NIDS Sensor (e.g. Suricata EVE log integration)
SURICATA_EVE_PATH=/var/log/suricata/eve.json
