# SecureNet AI Frontend Environment (.env) for Vercel / Local Vite
# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Local Sensor / Ngrok Tunnel Configuration
# Set to your Ngrok tunnel URL (e.g. https://your-domain.ngrok-free.app) or http://localhost:8000 for local dev
VITE_SENSOR_API_URL=https://your-domain.ngrok-free.app
